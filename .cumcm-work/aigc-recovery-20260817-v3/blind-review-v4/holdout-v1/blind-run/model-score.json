    {
      "pair_id": "holdout-07-line-207",
      "rater_id": "holdout-model-a",
      "rater_kind": "model",
      "text": "A补充了归一化指标的解释及资源承载机制，信息密度和推理链更充分。"
    },
    {
      "pair_id": "holdout-08-line-277",
      "rater_id": "holdout-model-a",
      "rater_kind": "model",
      "text": "A逐组说明各情景数值变化并保留过程变量作用，具体性和分析轨迹更强。"
    },
    {
      "pair_id": "holdout-09-line-422",
      "rater_id": "holdout-model-a",
      "rater_kind": "model",
      "text": "B的语句衔接更自然，并明确将局部跨越限定为不稳定现象。"
    },
    {
      "pair_id": "holdout-10-line-488",
      "rater_id": "holdout-model-a",
      "rater_kind": "model",
      "text": "A更具体地列出监测指标和治理环节，语气自然且行动建议更完整。"
