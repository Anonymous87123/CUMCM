1384.0],[1861.0,1427.0],[274.0,1426.0]]},{"text":"近的点可通过微调使其成为其中心。随后将15个点分成三类，逐步调整。进行计算","confidence":0.9452100678494102,"box":[[275.0,1440.0],[1861.0,1441.0],[1861.0,1483.0],[275.0,1482.0]]},{"text":"机的仿真模拟微小量的调整，随机生成初始数据，并分别计算三个引理所对应的误","confidence":0.9601079241649525,"box":[[276.0,1497.0],[1861.0,1498.0],[1861.0,1538.0],[276.0,1537.0]]},{"text":"差值与锥形阵列全局的误差值（通过三维平面拟合求误差平方和），评价模型的优劣","confidence":0.9347638942693409,"box":[[276.0,1553.0],[1860.0,1554.0],[1860.0,1594.0],[276.0,1593.0]]},{"text":"性。","confidence":0.6267198721567789,"box":[[273.0,1606.0],[346.0,1606.0],[346.0,1653.0],[273.0,1653.0]]},{"text":"综上所述，四个问题的分析思路可表示如下：","confidence":0.8877905862671989,"box":[[364.0,1667.0],[1191.0,1667.0],[1191.0,1703.0],[364.0,1703.0]]},{"text":"问题一，被动按受信号的无","confidence":0.7010248509737161,"box":[[386.0,1792.0],[676.0,1792.0],[676.0,1819.0],[386.0,1819.0]]},{"text":"问题二，主动发出信号的无","confidence":0.7404543849138113,"box":[[746.0,1792.0],[1040.0,1792.0],[1040.0,1819.0],[746.0,1819.0]]},{"text":"问急三：阅悉编队下无人机","confidence":0.5889566082220811,"box":[[1108.0,1793.0],[1399.0,1793.0],[1399.0,1819.0],[1108.0,1819.0]]},{"text":"向恩四：错形队下无人机","confidence":0.6937784540156523,"box":[[1471.0,1793.0],[1762.0,1793.0],[1762.0,1819.0],[1471.0,1819.0]]},{"text":"人机定位调整模型","confidence":0.8514153493775262,"box":[[433.0,1823.0],[628.0,1823.0],[628.0,1851.0],[433.0,1851.0]]},{"text":"位置的调整策略","confidence":0.6254897378385067,"box":[[1168.0,1822.0],[1340.0,1825.0],[1340.0,1852.0],[1167.0,1849.0]]},{"text":"人机数目确定模型","confidence":0.7151826355192397,"box":[[793.0,1824.0],[991.0,1824.0],[991.0,1852.0],[793.0,1852.0]]},{"text":"倪置的调整策略","confidence":0.6225714571774006,"box":[[1530.0,1823.0],[1701.0,1823.0],[1701.0,1851.0],[1530.0,1851.0]]},{"text":"方程问惠，可建立极坐标用","confidence":0.7139481225839028,"box":[[389.0,1931.0],[673.0,1930.0],[673.0,1957.0],[389.0,1958.0]]},{"text":"问题一的变式，核心是妞何","confidence":0.7376952790296994,"box":[[747.0,1931.0],[1037.0,1931.0],[1037.0,1958.0],[747.0,1958.0]]},{"text":"马部优化问题，首先